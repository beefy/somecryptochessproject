# Settings for the read-only mirror's Compose project.
#
#   cp .env.example .env && $EDITOR .env
#   docker compose pull node && docker compose up -d --no-build
#
# `.env` sits next to docker-compose.yml, so every `docker compose` command in
# this directory picks it up without exports on the command line. The deploy
# workflow writes the same file from the repository variables, so a manual run
# and an automated run cannot drift.

# The image the primary deploy published. `deploy-testnet-miners.yml` pushes
# `:testnet` and `:$GITHUB_SHA` on every merge; the mirror must run one of those
# tags, not a local build, or it replicates a different chain implementation
# than the node it copies.
SCCP_IMAGE=ghcr.io/chessproofofwork/somecryptochessproject:testnet

# The mirror's public name. Caddy obtains a certificate for exactly this name
# over HTTP-01, so its A record must point at the mirror VM and port 80 must be
# reachable before the first start.
SCCP_EDGE_DOMAIN=mirror.proofofchess.com

# The primary node's public base URL. The mirror fetches `/v1/status` and
# `/v1/blocks/<height>` from it; these are the same paths the app's `/v1` proxy
# serves, so the app origin is the right value.
SCCP_PRIMARY_URL=https://app.proofofchess.com

# Optional. Seconds between pull-sync polls (0 syncs once at startup, which is
# wrong for a replica). Default 30.
# SCCP_PEER_POLL_SECONDS=30
