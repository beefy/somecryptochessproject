# Two public names, one VM and one Caddy instance:
#
#   proofofchess.com      -> the landing page on 127.0.0.1:8081
#   app.proofofchess.com  -> the application on 127.0.0.1:8080
#
# The app serves its bundle, the node API under /v1 and the matchmaker under
# /relay. Every view is a hash route (`#/`, `#/wallet`, `#/play`, `#/dex`,
# `#/bridge`), so one app bundle and one app certificate cover all five.
#
# Each name gets its own certificate over HTTP-01. Both A records must point at
# this VM and port 80 must be reachable before the first deploy. Add an `email`
# in the global block if you want expiry notices from Let's Encrypt.
{
	# No DNS provider token here, so HTTP-01 is the challenge in use.
	# auto_https is on by default: :80 answers the challenge and redirects.
}

# The project overview: a static, crawlable first page that links into the app.
proofofchess.com {
	reverse_proxy 127.0.0.1:8081
}

# The application: explorer, wallet, Play, DEX and Bridge on one origin.
app.proofofchess.com {
	reverse_proxy 127.0.0.1:8080
}
