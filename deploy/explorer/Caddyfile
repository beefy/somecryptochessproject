# The public application origin. One domain serves one bundle, one nginx origin
# and one release directory; the browser's hash route (`#/`, `#/wallet`, `#/play`,
# `#/dex`, `#/bridge`) picks the view. One certificate covers the name, so one A
# record pointing at this VM and port 80 open is all the HTTP-01 challenge needs.
# Add an `email` in the global block if you want expiry notices from Let's Encrypt.
{
	# No DNS provider token here, so HTTP-01 is the challenge in use.
	# auto_https is on by default: :80 answers the challenge and redirects.
}

proofofchess.com {
	reverse_proxy 127.0.0.1:8080
}
